{
  "compilerOptions": {
    "target": "es6",
    "module": "commonjs",
    "outDir": "lib/cjs",
    "strict": true,
    "esModuleInterop": true,
    "allowJs": true,
    "sourceMap": true,
    "declaration": true,
	"declarationDir": "lib/types",
    "forceConsistentCasingInFileNames": true,
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "**/*.spec.ts"]
}
